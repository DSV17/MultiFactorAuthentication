{
  "name": "multifactorauthentication",
  "version": "1.0.0",
  "description": "API de sistema de login com autenticação MFA",
  "main": "index.js",
  "scripts": {
    "start": "npx ts-node-dev --transpile-only --no-notify server.ts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=\"tests/.*\\Unit\\Test\\.ts$\"",
    "test:integration": "jest --testPathPattern=\"tests/.*\\Integration\\Test\\.ts$\"",
    "keys": "npx ts-node src/config/generateRSAKeyPair.ts"
  },
  "prisma": {
    "schema": "src/models/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "prisma": "^6.13.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
